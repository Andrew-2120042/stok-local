# `npm run setup` writes this file for you, pointing at the local Supabase stack.
# Only edit by hand to use a hosted Supabase project or to enable optional services.

# ── Database (local Supabase defaults) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase (values from `npx supabase status`) ──────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_BUCKET=product-images
STORAGE_URL=http://127.0.0.1:54321/storage/v1/object/public

# ── Embeddings ─────────────────────────────────────────────────────────────────
# local  = built-in hashing embeddings, no API key (default)
# openai = text-embedding-3-small; also run scripts/set-trigger-config.ts + npm run reembed
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# ── Internal auth ──────────────────────────────────────────────────────────────
# Shared secret between the Next.js server and the API; protects /portal/* routes.
# Must match apps/web/.env.local. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Stripe (optional) ──────────────────────────────────────────────────────────
# Only needed for live-key orders with real card checkout. Sandbox keys
# (sk_test_am_...) run the whole order flow without Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3001/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=10
STRIPE_REQUIRE_CONNECT=false

# ── Email (optional) ───────────────────────────────────────────────────────────
# Leave blank to skip sending emails.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
CHECKOUT_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
